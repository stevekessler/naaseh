// TestFlight uses the existing production service after the smoke-account gate.
NAASEH_API_ORIGIN = https:/$()/gsd.thepandas.link
NAASEH_CALLBACK_SCHEME = naaseh
NAASEH_ASSOCIATED_DOMAIN = applinks:gsd.thepandas.link
NAASEH_APP_GROUP = group.link.thepandas.naaseh
NAASEH_APNS_ENVIRONMENT = production
NAASEH_CONTRACT_VERSION = 4
NAASEH_ENABLE_PRODUCTION_DATA = YES
NAASEH_ENABLE_NATIVE_TELEMETRY = YES
NAASEH_ENABLE_SIRI_ACTIONS = YES
NAASEH_ENABLE_NATIVE_ALERTS = YES
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0
VALIDATE_PRODUCT = YES
