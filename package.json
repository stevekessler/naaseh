{
  "name": "naaseh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @naaseh/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --config playwright.quick.config.ts",
    "test:safari-preview": "node tools/safari-technology-preview-smoke.mjs",
    "test:performance": "vitest run tests/performance",
    "test:performance:urgency-stack-ranking": "vitest run tests/performance/urgency-stack-ranking.test.ts",
    "calibrate:argon2": "node tools/calibrate-argon2-lambda.mjs",
    "test:observability": "vitest run packages/observability/test tests/security/operational-telemetry.security.test.ts infra/test/foundation.test.ts",
    "cdk:synth": "npm run synth -w @naaseh/infra --",
    "validate:pre-aws": "node tools/run-local-release-gates.mjs",
    "validate:pre-aws:browsers": "node tools/run-local-release-gates.mjs --browsers",
    "validate:workflows": "node tools/validate-github-actions.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:runtime": "node -e \"if (Number(process.versions.node.split('.')[0]) !== 24) { throw new Error('Naaseh requires Node.js 24.x') }\"",
    "validate": "npm run check:runtime && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "9.32.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.6",
    "vitest": "^3.2.6"
  }
}
